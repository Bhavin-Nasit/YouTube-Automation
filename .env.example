# Render app URL and endpoint protection
BASE_URL=https://your-render-service.onrender.com
WEBHOOK_SECRET=replace-with-a-long-random-secret
ADMIN_TOKEN=replace-with-a-different-long-random-token
AUTO_SUBSCRIBE_ON_STARTUP=true

# YouTube channel and OAuth credentials
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_UPLOADS_PLAYLIST_ID=
YOUTUBE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
YOUTUBE_REFRESH_TOKEN=your-google-oauth-refresh-token

# Metadata defaults that are always applied first
DEFAULT_DESCRIPTION=Thanks for watching {title}!\n\nSubscribe for more videos.\n\nTrending now: {trending_topics}\n{trending_hashtags}
DEFAULT_TAGS=your channel name,default topic,default keyword
DEFAULT_HASHTAGS=#YourChannel,#Subscribe
MAX_TAGS=45

# Trending enrichment from YouTube most-popular videos
ENABLE_TRENDING_ENRICHMENT=true
TRENDING_REGION_CODE=US
TRENDING_VIDEO_CATEGORY_ID=
TRENDING_LIMIT=15
TRENDING_TAG_LIMIT=12
TRENDING_TITLE_KEYWORD_LIMIT=8

# Update behavior
UPDATE_ONLY_EXISTING_VIDEOS=true
PROCESSED_STORE_PATH=data/processed_videos.json
DRY_RUN=false
